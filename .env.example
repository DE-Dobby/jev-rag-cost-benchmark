# Jev provider API 키 (로컬 개발용; Cloud Run Job에서는 Secret Manager에서 읽음)
JEV_API_KEY=

# GCP 프로젝트/리전 (Vertex AI 호출용)
GCP_PROJECT_ID=
GCP_REGION=us-west1

# Vertex AI 인증은 서비스 계정 ADC 사용 (키 파일을 여기 두지 않음)
# 로컬: `gcloud auth application-default login` 실행 후 비워둔 채로 사용
GOOGLE_APPLICATION_CREDENTIALS=

# 캐시 백엔드 전환용 (local | gcs)
CACHE_BACKEND=local
GCS_CACHE_BUCKET=
